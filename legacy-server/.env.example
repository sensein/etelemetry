# Copy to .env next to docker-compose.yml. Do NOT commit the real .env.
# MongoDB data/log bind-mount locations (relative to the compose dir, /home/ec2-user/src).
DB_DATA_DIR=../mongo-scratch/data
DB_LOG_DIR=../mongo-scratch/logs
# ipstack geolocation API key used by the server for request geo-IP lookups.
IPSTACK_API_KEY=replace-me
